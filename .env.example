# ==============================================================================
# S A RAICHUR SERVICE POINT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (e.g., MongoDB Atlas)
# If left blank, server falls back to storing bookings in server/data/bookings_atlas_mock.json
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/saraichur?retryWrites=true&w=majority

# JWT Token Secret for Admin Authentication
JWT_SECRET=saraichur_admin_jwt_secret_change_me_in_production

# Note: The codebase uses dynamic first-time admin setup (the first login registers the administrator).
# ADMIN_USER and ADMIN_PASS are legacy and no longer used by the active server codebase.
# ADMIN_USER=admin
# ADMIN_PASS=adminpassword123

# SMTP Email Notifications configuration (for Nodemailer)
# Populating these triggers automated emails to the admin when bookings are submitted.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-business-email@gmail.com
EMAIL_PASS=your-gmail-app-password
ADMIN_EMAIL=admin-receiver-email@gmail.com

# Frontend configuration (Vite Build Environment)
# If left blank, requests are routed relatively to /api
VITE_API_URL=

